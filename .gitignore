# OCaml build artifacts
*.cmi
*.cmo
*.cmx
*.o
*.a
*.cmxa
*.cmxs
*.cmt
*.cmti
*.annot

# Generated benchmark input data (recreated by build.deps.sh scripts)
*.data
with_deps/benchmarksgame/input*.txt

# Generated benchmark outputs (produced by benchmark runs, not inputs)
simple/minilight/*.ppm

# Dune build artifacts
_build/
_build-running/
.dune-workspace

# Benchmark binaries generated by running-ng convention
*-ocaml-local
*-ocaml-global
*-ocaml-*
*-oxcaml-*
*-mmtk*
markbench-runtime
infer/openssl-capture/

# Generic temporary/editor files
*~
.DS_Store
a.out

# CI artifacts: benchmark binaries built under the `ci` runtime tag by
# scripts/ci-build-all.sh (the tag .github/workflows/ci.yml sets), and the
# per-program build/run logs both CI and test-runtimes.sh write.
*-ci
ci-logs/
